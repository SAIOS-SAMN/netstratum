# THE MESH SCRIBE — netstratum resident on the mycelium as a peer.
# Solve records become MY-K offers on the kernel's own beat; no
# operator, no exporter. Seat outlives socket: restart re-attaches at
# the same topological address.
[Unit]
Description=netstratum mesh scribe (resident kernel on mycelium)
After=mycelium-hypha.service
Wants=mycelium-hypha.service

[Service]
ExecStart=/opt/netstratum/target/release/mesh-scribe --resident
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
