#!/usr/bin/env python3
"""Check that every relative link in the repository's Markdown resolves.

Usage: scripts/check-docs. Exits 1 and lists each broken link otherwise.
"""
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SKIP = {"target", "vendor", ".git", ".testtmp"}
LINK = re.compile(r"\[[^\]]*\]\(([^)\s]+)\)")

broken = []
for base, dirs, files in os.walk(ROOT):
    dirs[:] = [d for d in dirs if d not in SKIP]
    for name in files:
        if not name.endswith(".md"):
            continue
        path = os.path.join(base, name)
        text = open(path, encoding="utf-8").read()
        for target in LINK.findall(text):
            if target.startswith(("http://", "https://", "mailto:", "#")):
                continue
            file = target.split("#")[0]
            if file and not os.path.exists(os.path.join(base, file)):
                broken.append(f"{os.path.relpath(path, ROOT)}: {target}")

for b in broken:
    print(b)
print(f"check-docs: {len(broken)} broken link(s)")
sys.exit(1 if broken else 0)
